{
  "name": "search-guard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@contentful/rich-text-html-renderer": "^17.1.6",
    "@contentful/rich-text-react-renderer": "^16.1.6",
    "@contentful/rich-text-types": "^17.2.5",
    "algoliasearch": "^5.20.0",
    "contentful": "^7.5.0",
    "country-list": "^2.2.0",
    "eslint-plugin-react-hooks": "0.0.0-b53ea6ca0",
    "font-awesome": "^4.7.0",
    "fs": "0.0.1-security",
    "lunr": "^2.3.6",
    "markdown-to-jsx": "^6.10.3",
    "materialize-css": "^1.0.0",
    "node-fetch": "^2.6.0",
    "prop-types": "^15.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-ga": "^3.3.1",
    "react-headroom": "^3.2.1",
    "react-helmet-async": "^2.0.5",
    "react-instantsearch": "7.16.3",
    "react-router-dom": "^6.30.3",
    "react-router-hash-link": "^1.2.2",
    "react-share": "^5.2.2",
    "react-slugify": "^3.0.3",
    "react-svg": "^16.2.0",
    "react-transition-group": "^4.3.0",
    "serve": "^11.1.0",
    "serve-handler": "^6.1.2",
    "uuid": "^3.3.3"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "fetch": "node ./src/Api/fetchContentfulPosts.js && node ./src/Api/fetchContentfulEvents.js && node ./src/Api/fetchContentfulWhitepapers.js && node ./src/Api/fetchContentfulVideos.js && node ./src/Api/fetchContentfulPersons.js && node ./src/Api/fetchContentfulPageContents.js",
    "indexBlogPosts": "node ./src/Api/indexBlogposts.js",
    "build": "npm run fetch && node ./scripts/build-ssg.js && node ./scripts/inject-seo-tags.js && npm run sitemap",
    "build-local": "vite build",
    "build:ssg": "node ./scripts/build-ssg.js",
    "prerender": "node ./scripts/prerender.js",
    "preview": "vite preview",
    "sitemap": "./scripts/sitemap.js -- --base-url='https://search-guard.com/'",
    "postbuild": "./scripts/sitemap.js -- --base-url='https://search-guard.com/'",
    "clearReactChunks": "node ./src/Api/cleanReactChunksPostBuild.js",
    "clean": "rm -rf dist/*",
    "lint": "eslint src -c .eslintrc --ext js,jsx",
    "extractpostslugs": "node ./src/Api/extractBlogSlugs.js",
    "find-unused-images": "node scripts/find-unused-images.js",
    "delete-unused-images": "node scripts/find-unused-images.js --delete-images=true"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "@babel/core": "^7.4.0",
    "@babel/polyfill": "^7.4.0",
    "@babel/preset-env": "^7.4.2",
    "@babel/preset-react": "^7.0.0",
    "@leadhome/react-snap-sitemap": "^0.1.4",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "babel-loader": "^8.0.5",
    "css-loader": "^2.1.1",
    "dotenv": "^8.2.0",
    "ember-cli-materialize": "^0.22.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-webpack": "^0.11.0",
    "eslint-loader": "^2.1.2",
    "eslint-plugin-import": "^2.16.0",
    "eslint-plugin-jsx-a11y": "^6.2.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.12.4",
    "extract-text-webpack-plugin": "^4.0.0-beta.0",
    "file-loader": "^3.0.1",
    "html-webpack-plugin": "^3.2.0",
    "node-sass": "npm:sass@^1.53.0",
    "path": "^0.12.7",
    "prettier": "^3.7.4",
    "puppeteer": "^24.34.0",
    "sass": "^1.97.2",
    "sass-loader": "^7.1.0",
    "style-loader": "^0.23.1",
    "uglifyjs-webpack-plugin": "^2.1.2",
    "vite": "^7.3.1",
    "vite-plugin-svgr": "^4.5.0",
    "webpack-command": "^0.4.2",
    "webpack-merge": "^4.2.1"
  },
  "reactSnap": {
    "skipThirdPartyRequests": true,
    "preconnectThirdParty": false,
    "concurrency": 16,
    "viewport": {
      "width": 1280,
      "height": 767
    },
    "include": [
      "/security-for-elasticsearch/",
      "/elasticsearch-kibana-security/",
      "/thanks/",
      "/search-guard-flx/",
      "/sitemap/",
      "/heise/",
      "/outdated-elasticsearch-versions-suppport/",
      "/authors/",
      "/newsletter/"
    ],
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ]
  }
}
