{
  "name": "search-guard",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@contentful/rich-text-html-renderer": "^13.1.0",
    "@contentful/rich-text-react-renderer": "^13.2.0",
    "@contentful/rich-text-types": "^13.1.0",
    "contentful": "^7.5.0",
    "font-awesome": "^4.7.0",
    "lunr": "^2.3.6",
    "markdown-to-jsx": "^6.10.3",
    "materialize-css": "^1.0.0-rc.2",
    "prop-types": "^15.7.2",
    "react": "^16.8.4",
    "react-dom": "^16.8.4",
    "react-helmet": "^5.2.1",
    "react-intl": "^2.8.0",
    "react-intl-cra": "^0.3.4",
    "react-intl-translations-manager": "^5.0.3",
    "react-router-dom": "^5.0.0",
    "react-scripts": "2.1.8",
    "react-snapshot": "^1.3.0",
    "serve": "^11.1.0"
  },
  "scripts": {
    "heroku-postbuild": "npm run build",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "clean": "rm -rf build/*",
    "start:dev": "node config/webpack-dev-server.js",
    "start:prod": "npm build; serve build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "extract:messages": "react-intl-cra 'src/**/*.{js,jsx}' -o 'src/i18n/messages/messages.json'",
    "manage:translations": "node ./translationRunner.js",
    "lint": "eslint src -c .eslintrc --ext js,jsx",
    "deploy": "npm run build && aws s3 sync ./build/ s3://www.search-guard.com --profile=searchguard && open http://www.search-guard.com.s3-website.eu-central-1.amazonaws.com/ "
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "@babel/core": "^7.4.0",
    "@babel/polyfill": "^7.4.0",
    "@babel/preset-env": "^7.4.2",
    "@babel/preset-react": "^7.0.0",
    "babel-loader": "^8.0.5",
    "css-loader": "^2.1.1",
    "ember-cli-materialize": "^0.22.0",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-config-prettier": "^4.1.0",
    "eslint-import-resolver-webpack": "^0.11.0",
    "eslint-loader": "^2.1.2",
    "eslint-plugin-import": "^2.16.0",
    "eslint-plugin-jsx-a11y": "^6.2.1",
    "eslint-plugin-prettier": "^3.0.1",
    "eslint-plugin-react": "^7.12.4",
    "extract-text-webpack-plugin": "^4.0.0-beta.0",
    "file-loader": "^3.0.1",
    "html-webpack-plugin": "^3.2.0",
    "node-sass": "^4.11.0",
    "path": "^0.12.7",
    "prettier": "^1.16.4",
    "react-hot-loader": "^4.8.0",
    "sass": "*",
    "sass-loader": "^7.1.0",
    "style-loader": "^0.23.1",
    "uglifyjs-webpack-plugin": "^2.1.2",
    "webpack-command": "^0.4.2",
    "webpack-merge": "^4.2.1"
  }
}
