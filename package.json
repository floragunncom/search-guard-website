{
  "name": "search-guard",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "@contentful/rich-text-html-renderer": "^17.1.5",
    "@contentful/rich-text-react-renderer": "^16.1.6",
    "@contentful/rich-text-types": "^17.2.5",
    "algoliasearch": "^5.20.0",
    "contentful": "^11.3.1",
    "country-list": "^2.2.0",
    "font-awesome": "^4.7.0",
    "i18next": "^25.8.8",
    "markdown-to-jsx": "^7.7.16",
    "materialize-css": "^1.0.0",
    "next": "^15.1.6",
    "node-fetch": "^2.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-ga": "^3.3.1",
    "react-headroom": "^3.2.1",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^16.5.4",
    "react-instantsearch": "7.16.3",
    "react-router-dom": "^5.3.4",
    "react-router-hash-link": "^2.4.3",
    "react-share": "^5.2.2",
    "react-slugify": "^5.0.0",
    "react-svg": "^16.3.0",
    "react-transition-group": "^4.4.5",
    "serve-handler": "^6.1.6",
    "uuid": "^9.0.1"
  },
  "scripts": {
    "start": "next dev",
    "start:dev": "next dev",
    "start:prod": "npm run build && node .",
    "preview": "next start",
    "fetch": "node ./src/Api/fetchContentfulPosts.js && node ./src/Api/fetchContentfulEvents.js && node ./src/Api/fetchContentfulWhitepapers.js && node ./src/Api/fetchContentfulVideos.js && node ./src/Api/fetchContentfulPersons.js",
    "indexBlogPosts": "node ./src/Api/indexBlogposts.js",
    "prerender:report": "node ./scripts/report-prerender-routes.js",
    "prerender": "node ./scripts/prerender.js",
    "sitemap": "node ./scripts/sitemap.js --base-url=https://search-guard.com/ --out-dir=out",
    "build": "npm run fetch && npm run next:build && npm run sitemap",
    "build-local": "npm run next:build && npm run sitemap",
    "clearReactChunks": "node ./src/Api/cleanReactChunksPostBuild.js",
    "clean": "rm -rf dist/*",
    "test": "echo 'No tests configured'",
    "lint": "eslint src -c .eslintrc --ext js,jsx",
    "extractpostslugs": "node ./src/Api/extractBlogSlugs.js",
    "find-unused-images": "node scripts/find-unused-images.js",
    "delete-unused-images": "node scripts/find-unused-images.js --delete-images=true",
    "next:dev": "next dev",
    "next:build": "next build",
    "vite:dev": "vite",
    "vite:build": "npm run fetch && npm run prerender:report && vite build && npm run prerender && npm run sitemap",
    "vite:build-local": "npm run prerender:report && vite build && npm run prerender && npm run sitemap",
    "next:export-dist": "echo \"Deprecated: Next.js exports directly to out/\""
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "puppeteer": "^24.2.0",
    "sass": "^1.83.4",
    "vite": "^6.0.11"
  },
  "overrides": {
    "ini": "^1.3.8"
  }
}
