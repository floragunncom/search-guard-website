          "fields": {
            "question": "What is Search Guard?",
            "answer": "Search Guard is an Enterprise Security Suite that encrypts and protects your data and data flows in the entire Elastic Stack, including Kibana, Logstash and Beats."
          }
        },
        {
          "metadata": {
            "tags": []
          },
          "sys": {
            "space": {
