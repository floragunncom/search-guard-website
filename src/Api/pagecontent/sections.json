              }
            },
            "locale": "en-US"
          },
          "fields": {
            "question": "My company is non-profit, do you offer any discounts?",
            "answer": "Absolutely. We want to give back to education and science and provide special discounts and free licenses for eligible institutions. [Get in touch with us](https://search-guard.com/contacts/) to learn more about our education & scientific licensing."
          }
